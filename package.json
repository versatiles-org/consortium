{
	"name": "@versatiles/consortium",
	"version": "0.0.1",
	"description": "Landing page and open letter for founding the VersaTiles consortium (versatiles.org/consortium).",
	"license": "MIT",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "npm run check:ts && npm run check:lint && npm run check:svelte && npm run format",
		"check:ts": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:lint": "eslint --color .",
		"format": "prettier --write --log-level warn .",
		"format:check": "prettier --check .",
		"build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && BASE_PATH=/consortium vite build && npm run build:og",
		"build:og": "node scripts/og-shot.ts",
		"dev": "vite dev",
		"preview": "vite preview",
		"upgrade": "npm-check-updates -u && rm -rf node_modules package-lock.json && npm install"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.3",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"marked": "^18.0.14",
		"npm-check-updates": "^23.1.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"sass-embedded": "^1.105.0",
		"sharp": "^0.35.5",
		"sirv": "^3.0.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.1",
		"yaml": "^2.9.1",
		"zod": "^4.6.5"
	},
	"engines": {
		"node": ">=24"
	},
	"allowScripts": {
		"@parcel/watcher": true,
		"fsevents": true
	}
}
